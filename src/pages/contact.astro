---
import BaseLayout from '../layouts/BaseLayout.astro'; import SectionIntro from '../components/SectionIntro.astro';
---
<BaseLayout title="Contact | Obrien TG" description="Contact Obrien TG about a project, junior role, or freelance build."><SectionIntro eyebrow="Let’s talk" title="Start a conversation" intro="Share a little context and I’ll have the information needed to understand your project or opportunity."/><form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="mt-12 max-w-2xl space-y-6 rounded-2xl border border-slate-800 bg-panel/70 p-6 sm:p-8"><input type="hidden" name="form-name" value="contact" /><p class="hidden"><label>Don’t fill this out <input name="bot-field" /></label></p><div><label class="font-medium text-white" for="name">Name</label><input required id="name" name="name" autocomplete="name" class="mt-2 w-full rounded-lg border border-slate-700 bg-ink px-4 py-3 text-white" /></div><div><label class="font-medium text-white" for="email">Email</label><input required type="email" id="email" name="email" autocomplete="email" class="mt-2 w-full rounded-lg border border-slate-700 bg-ink px-4 py-3 text-white" /></div><div><label class="font-medium text-white" for="context">Project context</label><input id="context" name="project-context" class="mt-2 w-full rounded-lg border border-slate-700 bg-ink px-4 py-3 text-white" /></div><div><label class="font-medium text-white" for="message">Message</label><textarea required id="message" name="message" rows="6" class="mt-2 w-full rounded-lg border border-slate-700 bg-ink px-4 py-3 text-white"></textarea></div><p class="text-sm text-slate-400">By submitting, you agree that I may use your details to respond to this message.</p><button class="rounded-lg bg-ice px-5 py-3 font-semibold text-ink hover:bg-white" type="submit">Send message</button></form></BaseLayout>
