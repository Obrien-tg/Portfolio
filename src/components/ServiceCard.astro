---
const { title, description } = Astro.props;
---

<article
  class="group rounded-2xl border border-slate-800 bg-panel/70 p-6 transition duration-300 hover:-translate-y-0.5 hover:border-ice/40 hover:bg-panel/80 hover:shadow-[0_0_40px_-12px_rgba(139,233,253,0.35)]"
>
  <h2 class="font-display text-xl font-semibold text-white transition-colors group-hover:text-ice">
    {title}
  </h2>
  <p class="mt-3 leading-7 text-slate-300">{description}</p>
</article>
