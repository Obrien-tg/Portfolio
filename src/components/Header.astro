---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/work/', label: 'Work' },
  { href: '/services/', label: 'Services' },
  { href: '/contact/', label: 'Contact' },
];
const normalise = (path: string) => path.endsWith('/') ? path : `${path}/`;
const currentPath = normalise(Astro.url.pathname);
---

<header class="sticky top-0 z-40 border-b border-slate-800/80 bg-ink/95 backdrop-blur">
  <nav aria-label="Primary navigation" class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
    <a href="/" class="inline-flex items-center gap-2 font-display text-xl font-semibold tracking-wide text-white"><svg viewBox="0 0 64 64" class="h-5 w-5 text-ice" aria-hidden="true"><path fill="currentColor" d="M32 4l6.5 21.5L60 32l-21.5 6.5L32 60l-6.5-21.5L4 32l21.5-6.5z"/></svg><span>Obrien <span class="text-ice">TG</span></span></a>
    <details class="sm:hidden">
      <summary class="cursor-pointer list-none rounded-lg border border-slate-800 px-3 py-1.5 text-sm text-slate-200">Menu</summary>
      <div class="mt-2 flex flex-col gap-2 rounded-xl border border-slate-800 bg-panel p-3 text-sm">
        {links.map((link) => <a class="hover:text-ice" href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>)}
      </div>
    </details>
    <div class="hidden gap-1 sm:flex sm:gap-3">
      {links.map((link) => <a href={link.href} class="rounded-lg px-2 py-2 text-sm text-slate-300 hover:bg-slate-800 hover:text-white sm:px-3" aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>)}
    </div>
  </nav>
</header>
