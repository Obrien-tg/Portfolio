---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionIntro from '../components/SectionIntro.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { services } from '../data';
---

<BaseLayout
  title="Services | Obrien TG"
  description="I help everyday people and small businesses turn ideas into websites, apps, and digital tools."
>
  <SectionIntro
    eyebrow="Ways I can help"
    title="Services"
    intro="I help everyday people and small businesses turn ideas into websites, apps, and digital tools. Whether you're starting fresh, keeping something running, fixing what's broken, or ready to grow — this is the work."
  />
  <div class="mt-12 grid gap-5 sm:grid-cols-2">
    {services.map((service) => <ServiceCard title={service.title} description={service.description} />)}
  </div>
</BaseLayout>
