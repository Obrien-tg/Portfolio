---
const { project } = Astro.props;
---

<article
  class="group flex h-full flex-col rounded-2xl border border-slate-800 bg-panel/70 p-6 transition duration-300 hover:-translate-y-0.5 hover:border-ice/40 hover:bg-panel/80 hover:shadow-[0_0_40px_-12px_rgba(139,233,253,0.35)]"
>
  <div class="flex items-start justify-between gap-3">
    <h2 class="font-display text-2xl font-semibold text-white transition-colors group-hover:text-ice">
      {project.name}
    </h2>
    <span
      class={`shrink-0 rounded-full border px-2.5 py-0.5 text-xs font-medium ${project.status === 'Live' ? 'border-emerald-400/40 bg-emerald-400/10 text-emerald-300' : 'border-slate-600 text-slate-300'}`}
    >
      {project.status}
    </span>
  </div>
  <p class="mt-3 leading-7 text-slate-300">{project.description}</p>
  {project.highlight && <p class="mt-3 text-sm leading-6 text-slate-400">{project.highlight}</p>}
  {project.stack && (
    <ul class="mt-4 flex flex-wrap gap-2" aria-label="Technologies used">
      {project.stack.map((tech: string) => (
        <li class="rounded-md bg-slate-800/80 px-2 py-1 text-xs text-slate-300">{tech}</li>
      ))}
    </ul>
  )}
  <div class="mt-auto flex flex-wrap gap-3 pt-6">
    <a
      class="inline-flex w-fit rounded-lg bg-ice px-4 py-2 font-semibold text-ink hover:bg-white"
      href={project.url}
      target="_blank"
      rel="noopener noreferrer"
    >
      View code <span aria-hidden="true">↗</span>
    </a>
    {project.liveUrl && (
      <a
        class="inline-flex w-fit rounded-lg border border-slate-600 px-4 py-2 font-semibold text-white hover:border-ice"
        href={project.liveUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Live site <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>
</article>
