---
import BaseLayout from '../layouts/BaseLayout.astro'; import SectionIntro from '../components/SectionIntro.astro'; import ServiceCard from '../components/ServiceCard.astro'; import { services } from '../data';
---
<BaseLayout title="Services | Obrien TG" description="Practical web development and delivery support from Obrien TG."><SectionIntro eyebrow="Ways I can help" title="Services" intro="Implementation-first support for products that need clean code and reliable delivery, whether you are hiring a builder or outsourcing a focused milestone."/><div class="mt-12 grid gap-5 sm:grid-cols-2">{services.map(([title, description]) => <ServiceCard title={title} description={description} />)}</div></BaseLayout>
