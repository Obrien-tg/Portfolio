---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionIntro from '../components/SectionIntro.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { services, faqs } from '../data';
---

<BaseLayout
  title="Services | Obrien TG"
  description="Practical website, app, and digital-tool development for individuals and small businesses. Start with a conversation about what you need."
>
  <SectionIntro
    eyebrow="Ways I can help"
    title="Let's make the useful thing."
    intro="You don't need to arrive with a perfect brief or all the technical answers. Tell me what you're trying to do, what's getting in the way, or what you wish existed. We'll work out whether I can help and what a sensible first step looks like."
  />
  <div class="mt-12 grid gap-5 sm:grid-cols-2">
    {services.map((service) => <ServiceCard {...service} />)}
  </div>
  <section class="mt-12 rounded-2xl border border-slate-800 bg-panel/70 p-6 sm:p-8">
    <p class="text-xs font-semibold uppercase tracking-[.2em] text-ice">How we can work together</p>
    <h2 class="mt-3 font-display text-2xl font-semibold text-white">A clear start, no unnecessary mystery.</h2>
    <ol class="mt-6 grid gap-6 sm:grid-cols-3">
      <li><span class="text-sm font-semibold text-ice">01 / Talk</span><h3 class="mt-2 font-semibold text-white">Tell me what you need</h3><p class="mt-2 text-sm leading-7 text-slate-400">A message is enough to start. We'll clarify the goal, audience, and what's most important.</p></li>
      <li><span class="text-sm font-semibold text-ice">02 / Plan</span><h3 class="mt-2 font-semibold text-white">Agree on a sensible scope</h3><p class="mt-2 text-sm leading-7 text-slate-400">We'll discuss the approach, deliverables, timing, and budget before work begins.</p></li>
      <li><span class="text-sm font-semibold text-ice">03 / Build</span><h3 class="mt-2 font-semibold text-white">Make progress together</h3><p class="mt-2 text-sm leading-7 text-slate-400">Stay in the loop, review the work, and make decisions with the goal in sight.</p></li>
    </ol>
  </section>
  <section class="mt-12" aria-labelledby="faq-heading">
    <p class="text-xs font-semibold uppercase tracking-[.2em] text-ice">Good to know</p>
    <h2 id="faq-heading" class="mt-3 font-display text-2xl font-semibold text-white">Common questions</h2>
    <div class="mt-6 divide-y divide-slate-800 rounded-2xl border border-slate-800 bg-panel/70">
      {faqs.map((item) => (
        <details class="group p-5">
          <summary class="cursor-pointer list-none font-semibold text-white marker:hidden">{item.q}</summary>
          <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-300">{item.a}</p>
        </details>
      ))}
    </div>
    <p class="mt-4 text-xs text-slate-500">Prices are starting points in South African rand and are confirmed in a written quote before work begins.</p>
  </section>
  <p class="mt-8 max-w-2xl text-sm leading-7 text-slate-400">Not sure which service fits? That's fine. Start with the problem, not the technical solution.</p>
  <a class="mt-4 inline-flex rounded-lg bg-ice px-5 py-3 font-semibold text-ink hover:bg-white" href="/contact/">Tell me about your idea</a>
</BaseLayout>
