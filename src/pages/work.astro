---
import BaseLayout from '../layouts/BaseLayout.astro'; import SectionIntro from '../components/SectionIntro.astro'; import ProjectCard from '../components/ProjectCard.astro'; import { projects } from '../data';
---
<BaseLayout title="Work | Obrien TG" description="Verified repository projects by Obrien TG."><SectionIntro eyebrow="Selected work" title="Proof over promises" intro="A small selection of projects with links to their source repositories. Where outcomes are not documented, I leave them unclaimed."/><div class="mt-12 grid gap-5 sm:grid-cols-2">{projects.map((project) => <ProjectCard project={project} />)}</div><a class="mt-8 inline-block text-ice underline underline-offset-4 hover:text-white" href="https://github.com/Obrien-tg" target="_blank" rel="noopener noreferrer">Browse the full GitHub profile ↗</a></BaseLayout>
