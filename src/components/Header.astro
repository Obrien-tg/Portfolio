---
const links = [['Home', '/'], ['About', '/about/'], ['Work', '/work/'], ['Services', '/services/'], ['Contact', '/contact/']];
---

<header class="sticky top-0 z-40 border-b border-slate-800/80 bg-ink/95 backdrop-blur">
  <nav aria-label="Primary navigation" class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
    <a href="/" class="font-display text-xl font-semibold tracking-wide text-white">Obrien <span class="text-ice">TG</span></a>
    <details class="sm:hidden">
      <summary class="cursor-pointer list-none rounded-lg border border-slate-800 px-3 py-1.5 text-sm text-slate-200">Menu</summary>
      <div class="mt-2 flex flex-col gap-2 rounded-xl border border-slate-800 bg-panel p-3 text-sm">
        <a class="hover:text-ice" href="/">Home</a><a class="hover:text-ice" href="/about/">About</a><a class="hover:text-ice" href="/work/">Work</a><a class="hover:text-ice" href="/services/">Services</a><a class="hover:text-ice" href="/contact/">Contact</a>
      </div>
    </details>
    <div class="hidden gap-1 sm:flex sm:gap-3">
      {links.map(([label, href]) => <a href={href} class="rounded-lg px-2 py-2 text-sm text-slate-300 hover:bg-slate-800 hover:text-white sm:px-3">{label}</a>)}
    </div>
  </nav>
</header>
