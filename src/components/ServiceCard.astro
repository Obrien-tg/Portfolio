---
const { title, description, from, forWho, includes = [] } = Astro.props;
---

<article
  class="group flex h-full flex-col rounded-2xl border border-slate-800 bg-panel/70 p-6 transition duration-300 hover:-translate-y-0.5 hover:border-ice/40 hover:bg-panel/80 hover:shadow-[0_0_40px_-12px_rgba(139,233,253,0.35)]"
>
  <h2 class="font-display text-xl font-semibold text-white transition-colors group-hover:text-ice">
    {title}
  </h2>
  {from && <p class="mt-1 text-sm font-semibold text-ice">{from}</p>}
  {forWho && <p class="mt-3 text-sm italic text-slate-400">{forWho}</p>}
  <p class="mt-3 leading-7 text-slate-300">{description}</p>
  {includes.length > 0 && (
    <ul class="mt-4 space-y-2 text-sm text-slate-300">
      {includes.map((item: string) => (
        <li class="flex gap-2"><span class="text-ice" aria-hidden="true">✓</span><span>{item}</span></li>
      ))}
    </ul>
  )}
</article>
