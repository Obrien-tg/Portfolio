---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Obrien TG | Full-stack and DevOps developer" description="Portfolio of Obrien Takunda Gwanyanya, a full-stack and DevOps-focused builder.">
  <section class="grid min-h-[65vh] items-center gap-12 md:grid-cols-[1.2fr_.8fr]">
    <div>
      <p class="mb-4 max-w-2xl text-sm leading-7 text-slate-400">I build websites, apps, and digital tools for people who have an idea and need it made real — cleanly, honestly, and built to last.</p>
      <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-ice/30 bg-ice/5 px-3 py-1 text-xs text-ice/90">
        <span class="h-1.5 w-1.5 rounded-full bg-ice" aria-hidden="true"></span>
        Open to junior roles and freelance builds
      </p>
      <h1 class="font-display text-5xl font-semibold leading-tight text-white sm:text-7xl">Software that ships, scales, and stays reliable.</h1>
      <p class="mt-4 text-sm italic text-slate-400">A wave in the ocean.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="rounded-lg bg-ice px-5 py-3 font-semibold text-ink hover:bg-white" href="/work/">See projects</a>
        <a class="rounded-lg border border-slate-600 px-5 py-3 font-semibold text-white hover:border-ice" href="/contact/">Start a conversation</a>
      </div>
      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-slate-800 pt-4 text-xs text-slate-400">
        <span>Real projects</span><span class="text-slate-600">·</span><span>Live links where they exist</span><span class="text-slate-600">·</span><span>No invented metrics</span>
      </div>
    </div>
    <img src="/images/hero.webp" alt="Portrait of Obrien Takunda Gwanyanya" class="mx-auto w-full max-w-sm rounded-3xl border border-slate-700 shadow-2xl" />
  </section>
</BaseLayout>
